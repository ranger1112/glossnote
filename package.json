{
  "name": "glossnote",
  "private": true,
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "GlossNote — 本地优先的 PDF 阅读与标注客户端。",
  "author": "ranger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranger1112/glossnote.git"
  },
  "bugs": {
    "url": "https://github.com/ranger1112/glossnote/issues"
  },
  "homepage": "https://github.com/ranger1112/glossnote#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pdfjs:assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "npm run pdfjs:assets && vite",
    "build": "tsc --noEmit && npm run pdfjs:assets && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-versions.mjs",
    "sample": "node scripts/make-sample.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
