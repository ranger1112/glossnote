{
  "name": "glossnote",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "GlossNote — 在文档上批注，把标注沉淀成知识。",
  "scripts": {
    "pdfjs:assets": "node scripts/copy-pdfjs-assets.mjs",
